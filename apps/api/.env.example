# jConv API (NestJS) — copie para .env dentro de apps/api

SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-chave-anon-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-aqui

PORT=3001
NODE_ENV=development
URL_FRONTEND=http://localhost:3000
# Conexao com o Postgres: e por ela que a API entra no schema do municipio.
#
# EM PRODUCAO use o pooler (Supavisor), nao o host direto. O "db.PROJETO.supabase.co" so tem
# registro AAAA — resolve exclusivamente em IPv6 — e o Railway nao tem saida IPv6: a conexao
# morre com ENETUNREACH e toda rota que toca o banco vira 500. O pooler responde em IPv4.
#
# A porta 6543 e o modo transacao, que e o que a API usa: cada requisicao abre BEGIN, define
# search_path e papel com SET LOCAL, e fecha com COMMIT — tudo dentro de uma transacao so.
#
# Producao:
# SUPABASE_DB_URL=postgresql://postgres.PROJETO:SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres
#
# Local (host direto serve, e e melhor para rodar migrations e DDL):
SUPABASE_DB_URL=postgresql://postgres:SENHA@db.PROJETO.supabase.co:5432/postgres
